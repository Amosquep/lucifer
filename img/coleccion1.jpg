* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: 'Segoe UI', sans-serif;
  background-color: #fff7f8;
  color: #3b252c;
}

.hero {
  min-height: 100vh;
  background: linear-gradient(rgba(48, 18, 28, 0.65), rgba(48, 18, 28, 0.65)),
    url("/landing-campana/img/lenceria-hero.jpg.jpeg");
  background-size: cover;
  background-position: center;
  color: white;
}

.navbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 25px 8%;
}

.logo {
  font-size: 28px;
  letter-spacing: 1px;
}

.navbar ul {
  list-style: none;
  display: flex;
  gap: 25px;
}

.navbar a {
  color: white;
  text-decoration: none;
  font-weight: 500;
}

.navbar a:hover {
  color: #f8c8d0;
}

.hero-content {
  max-width: 650px;
  padding: 130px 8%;
  animation: fadeHero 1.5s ease;
}

.hero-content h1 {
  font-size: 56px;
  margin-bottom: 20px;
}

.hero-content p {
  font-size: 20px;
  margin-bottom: 30px;
}

@keyframes fadeHero {
  from {
    opacity: 0;
    transform: translateY(40px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.btn {
  display: inline-block;
  background: linear-gradient(45deg, #d96b8a, #ff8fab);
  color: white;
  padding: 14px 28px;
  border-radius: 30px;
  text-decoration: none;
  font-weight: bold;
  transition: 0.3s;
}

.btn:hover {
  transform: scale(1.05);
  box-shadow: 0 8px 20px rgba(217, 107, 138, 0.4);
}

.section {
  padding: 80px 8%;
  text-align: center;
}

.section h2,
.benefits h2,
.contact h2 {
  font-size: 38px;
  margin-bottom: 15px;
  color: #8b2f4a;
}

.intro {
  margin-bottom: 45px;
  color: #6d4b55;
}

.cards {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 25px;
}

.card {
  background-color: white;
  border-radius: 22px;
  overflow: hidden;
  box-shadow: 0 12px 30px rgba(139, 47, 74, 0.15);
  transition: 0.3s;
}

.card:hover {
  transform: translateY(-8px);
}

.img {
  height: 260px;
  background-size: cover;
  background-position: center;
}

.img1 {
  background-image: url("/IMG/coleccion1.jpg.jpeg");
}

.img2 {
  background-image: url("/IMG/coleccion2.jpg.jpeg");
}

.img3 {
  background-image: url("/IMG/coleccion3.jpg.jpeg");
}

.card h3 {
  margin: 20px 0 10px;
  color: #8b2f4a;
}

.card p {
  padding: 0 20px 25px;
  color: #6d4b55;
}

.benefits {
  background-color: #f3d9df;
  padding: 80px 8%;
  text-align: center;
}

.benefit-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 25px;
  margin-top: 35px;
}

.benefit-grid div {
  background-color: white;
  padding: 35px;
  border-radius: 20px;
  box-shadow: 0 8px 25px rgba(139, 47, 74, 0.12);
}

.benefit-grid h3 {
  color: #8b2f4a;
  margin-bottom: 12px;
}

.oferta {
  background: linear-gradient(45deg, #8b2f4a, #d96b8a);
  color: white;
  text-align: center;
  padding: 70px 20px;
}

.oferta h2 {
  font-size: 36px;
  margin-bottom: 15px;
}

.oferta p {
  margin-bottom: 25px;
}

.oferta button {
  background-color: white;
  color: #8b2f4a;
  padding: 14px 25px;
  border-radius: 30px;
  border: none;
  font-weight: bold;
  cursor: pointer;
}

.oferta button:hover {
  background-color: #f8c8d0;
}

.contact {
  padding: 80px 8%;
  text-align: center;
}

.contact p {
  margin-bottom: 25px;
  color: #6d4b55;
}

form {
  display: flex;
  justify-content: center;
  gap: 12px;
  flex-wrap: wrap;
}

input {
  padding: 14px 20px;
  width: 300px;
  border: 1px solid #d9a7b5;
  border-radius: 30px;
  outline: none;
}

button {
  background-color: #8b2f4a;
  color: white;
  border: none;
  padding: 14px 25px;
  border-radius: 30px;
  cursor: pointer;
  font-weight: bold;
}

button:hover {
  background-color: #6f233a;
}

footer {
  background-color: #3b252c;
  color: white;
  text-align: center;
  padding: 25px;
}

.fade-in {
  opacity: 0;
  transform: translateY(30px);
  transition: all 0.8s ease;
}

.visible {
  opacity: 1;
  transform: translateY(0);
}

@media (max-width: 768px) {
  .navbar {
    flex-direction: column;
    gap: 20px;
  }

  .navbar ul {
    flex-direction: column;
    text-align: center;
  }

  .hero-content {
    padding: 100px 8%;
    text-align: center;
  }

  .hero-content h1 {
    font-size: 38px;
  }

  .cards,
  .benefit-grid {
    grid-template-columns: 1fr;
  }

  input {
    width: 100%;
  }
}

/* Contenedor general de imagen */
.img {
  width: 100%;
  height: 250px;
  border-radius: 12px;
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  margin-bottom: 15px;
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

/* Efecto hover opcional */
.card:hover .img {
  transform: scale(1.05);
  box-shadow: 0 10px 20px rgba(0,0,0,0.2);
}

/* Imágenes individuales (RUTAS VACÍAS) */
.img1 {
  background-image: url("/landing-campana/img/coleccion1.jpg.jpeg");
}

.img2 {
  background-image: url("/landing-campana/img/coleccion2.jpg.jpeg");
}

.img3 {
  background-image: url("/landing-campana/img/coleccion3.jpg.jpeg");
}
