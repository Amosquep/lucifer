* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  font-family: 'Segoe UI', Arial, sans-serif;
  background-color: #fff7f8;
  color: #3b252c;
}

.header {
  background: linear-gradient(45deg, #8b2f4a, #d96b8a);
  color: white;
  padding-bottom: 40px;
}

.navbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
  padding: 20px 8%;
}

.logo {
  font-size: 26px;
}

.navbar ul {
  display: flex;
  align-items: center;
  gap: 20px;
  list-style: none;
}

.navbar a {
  color: white;
  text-decoration: none;
  font-weight: 600;
}

.navbar a:hover {
  color: #f8c8d0;
}

.icono-carrito {
  background-color: white;
  color: #8b2f4a !important;
  padding: 8px 14px;
  border-radius: 25px;
}

#contador-carrito {
  background-color: #8b2f4a;
  color: white;
  padding: 2px 7px;
  border-radius: 50%;
  font-size: 13px;
}

.header-content {
  text-align: center;
  margin-top: 40px;
  padding: 0 20px;
}

.header-content h1 {
  font-size: 42px;
  margin-bottom: 10px;
}

.contenedor-principal {
  display: grid;
  grid-template-columns: minmax(0, 3fr) 360px;
  gap: 30px;
  padding: 60px 8%;
  align-items: start;
}

.catalogo {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 25px;
}

.producto {
  background-color: white;
  border-radius: 20px;
  padding: 16px;
  text-align: center;
  box-shadow: 0 10px 25px rgba(0, 0, 0, 0.10);
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.producto:hover {
  transform: translateY(-6px);
  box-shadow: 0 14px 28px rgba(0, 0, 0, 0.14);
}

.producto img {
  width: 100%;
  height: 260px;
  object-fit: cover;
  border-radius: 15px;
  background-color: #f8c8d0;
}

.categoria {
  display: inline-block;
  margin-top: 14px;
  padding: 5px 12px;
  border-radius: 999px;
  background-color: #fff0f3;
  color: #8b2f4a;
  font-size: 13px;
  font-weight: 700;
}

.producto h3 {
  margin: 12px 0 8px;
  font-size: 19px;
}

.descripcion {
  color: #6d4b55;
  font-size: 14px;
  line-height: 1.45;
  margin-bottom: 10px;
}

.detalle {
  color: #5a3a44;
  font-size: 13px;
  margin-bottom: 5px;
}

.precio {
  color: #8b2f4a;
  font-size: 20px;
  font-weight: 800;
  margin: 12px 0;
}

.producto button,
.btn-vaciar,
.btn-pagar {
  border: none;
  padding: 12px 20px;
  border-radius: 25px;
  cursor: pointer;
  font-weight: 700;
}

.producto button {
  background-color: #8b2f4a;
  color: white;
}

.producto button:hover {
  background-color: #6f233a;
}

.carrito {
  position: sticky;
  top: 20px;
  background-color: white;
  padding: 25px;
  border-radius: 20px;
  box-shadow: 0 10px 25px rgba(0, 0, 0, 0.10);
}

.carrito h2 {
  color: #8b2f4a;
  margin-bottom: 20px;
}

#lista-carrito {
  list-style: none;
  margin-bottom: 20px;
}

#lista-carrito li {
  background-color: #fff7f8;
  padding: 12px;
  border-radius: 10px;
  margin-bottom: 10px;
  display: flex;
  justify-content: space-between;
  gap: 12px;
  align-items: center;
}

#lista-carrito li button {
  background-color: #d96b8a;
  color: white;
  border: none;
  padding: 7px 12px;
  border-radius: 20px;
  cursor: pointer;
}

.carrito-vacio {
  display: block !important;
  color: #6d4b55;
}

.total {
  font-size: 20px;
  font-weight: 800;
  color: #8b2f4a;
  margin-bottom: 15px;
}

.botones-carrito {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
}

.btn-vaciar {
  background-color: #3b252c;
  color: white;
}

.btn-vaciar:hover {
  background-color: #1f1217;
}

.btn-pagar {
  background-color: #25d366;
  color: white;
}

.btn-pagar:hover {
  background-color: #1ebe5d;
}

.mensaje-error {
  grid-column: 1 / -1;
  background-color: white;
  border-radius: 18px;
  padding: 25px;
  box-shadow: 0 10px 25px rgba(0, 0, 0, 0.10);
}

footer {
  text-align: center;
  padding: 20px;
  background-color: #3b252c;
  color: white;
}

@media (max-width: 1100px) {
  .catalogo {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 900px) {
  .contenedor-principal {
    grid-template-columns: 1fr;
  }

  .carrito {
    position: static;
  }
}

@media (max-width: 600px) {
  .navbar {
    flex-direction: column;
  }

  .navbar ul {
    flex-wrap: wrap;
    justify-content: center;
  }

  .header-content h1 {
    font-size: 34px;
  }

  .contenedor-principal {
    padding: 40px 5%;
  }

  .catalogo {
    grid-template-columns: 1fr;
  }
}
